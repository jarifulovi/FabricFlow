{
  "name": "fabricflow",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage",
    "seed": "npx tsx src/database/seeds/index.ts",
    "seed:categories": "npx tsx src/database/seeds/categories.seed.ts",
    "seed:warehouses": "npx tsx src/database/seeds/warehouses.seed.ts",
    "seed:products": "npx tsx src/database/seeds/products.seed.ts",
    "seed:variants": "npx tsx src/database/seeds/variants.seed.ts",
    "seed:clear": "npx tsx src/database/seeds/clear.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Garments Inventory Management System",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.6",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
